<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>You're connected</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      background: #0f172a;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
    }

    .card {
      max-width: 420px;
      padding: 32px;
      background: #020617;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,.4);
    }

    h1 {
      margin-top: 0;
      font-size: 1.8rem;
    }

    p {
      line-height: 1.6;
      opacity: 0.9;
    }

    .success {
      font-size: 3rem;
      margin-bottom: 12px;
    }

    .hint {
      margin-top: 20px;
      font-size: 0.9rem;
      opacity: 0.75;
    }
  </style>

  <!-- 🔥 IMPORTANT: re-trigger openNDS -->
<script>
    window.onload = () => {
      const urlParams = new URLSearchParams(window.location.search);
      const sessionId = urlParams.get('session');
      const hint = document.querySelector('.hint');
      const card = document.querySelector('.card');

      if (!sessionId) {
        hint.innerHTML = "<span style='color:#ef4444'>Error: Session lost. Reconnect to WiFi.</span>";
        return;
      }

      const fasUrl = `/api/fas?session=${encodeURIComponent(sessionId)}`;
      let timeLeft = 5;

      const countdown = setInterval(() => {
        timeLeft--;
        hint.innerHTML = `Verifying payment in ${timeLeft}s...`;

        if (timeLeft <= 0) {
          clearInterval(countdown);
          
          // Update the UI to show the manual connection button
          hint.innerHTML = "Verification complete.";
          
          // Create the "Connect" button dynamically
          const btn = document.createElement('a');
          btn.href = fasUrl;
          btn.innerHTML = "ACTIVATE CONNECTION";
          btn.style.cssText = "display:block; margin-top:20px; padding:16px; background:#10b981; color:white; text-decoration:none; border-radius:8px; font-weight:bold; font-size:1.1rem;";
          
          card.appendChild(btn);

          // Try automatic redirect (might be blocked, which is why we show the button)
          window.location.href = fasUrl;
        }
      }, 1000);
    };
  </script>
</head>
<body>

  <div class="card">
    <div class="success">✅</div>
    <h1>You’re online</h1>

    <p>
      Your payment was successful and Wi-Fi access is now activating.
    </p>

    <p>
      Please wait a moment…
    </p>

    <div class="hint">
      You will be connected automatically.
    </div>
  </div>

</body>
</html>
